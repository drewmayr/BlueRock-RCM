# ===== BlueRock RCM — Backend environment =====

# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/bluerock_rcm?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT — generate strong random secrets (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# ===== Messaging providers (optional — sending goes live the moment these are set) =====
# Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Default Twilio from-number (E.164, e.g. +15551234567). Can be overridden per-agency.
TWILIO_FROM_NUMBER=""

# Resend (Email)
RESEND_API_KEY=""
# Default verified from-address. Can be overridden per-agency.
EMAIL_FROM_ADDRESS="hello@example.com"
EMAIL_FROM_NAME="BlueRock RCM"

# Automation engine — how often the scheduler runs (cron expression). Default: every minute.
SCHEDULER_CRON="* * * * *"
# Set to "false" to disable the in-process scheduler (e.g. if running a separate worker)
ENABLE_SCHEDULER="true"

# Number of days of recruit inactivity before a lead is considered "aged"
AGED_LEAD_DAYS=60
