// BlueRock RCM — Relationship automation CRM for life insurance agencies
// Multi-tenant SaaS: every record is scoped to an Agency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy & users
// ============================================================

model Agency {
  id       String @id @default(cuid())
  name     String
  timezone String @default("America/New_York")

  // Per-agency messaging identity (overrides server defaults when set)
  twilioFromNumber String?
  emailFromAddress String?
  emailFromName    String?

  // Per-agency provider credentials (optional override of server-wide keys)
  twilioAccountSid String?
  twilioAuthToken  String?
  resendApiKey     String?

  agedLeadDays Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  contacts    Contact[]
  policies    Policy[]
  referrals   Referral[]
  crossSells  CrossSell[]
  lifeEvents  LifeEvent[]
  tasks         Task[]
  sequences     Sequence[]
  enrollments   Enrollment[]
  messages      Message[]
  activities    Activity[]
  notifications Notification[]
}

enum Role {
  OWNER
  MANAGER
  AGENT
  RECRUITER
  ASSISTANT
  SUPPORT
  TRAINER
}

model Invitation {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email       String
  firstName   String?
  lastName    String?
  role        Role      @default(AGENT)
  token       String    @unique
  status      String    @default("PENDING") // PENDING, ACCEPTED, REVOKED
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([agencyId, status])
  @@index([token])
}

model User {
  id           String  @id @default(cuid())
  agencyId     String
  agency       Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role    @default(AGENT)
  isActive     Boolean @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedContacts Contact[]  @relation("ContactOwner")
  tasks            Task[]
  activities       Activity[]

  @@index([agencyId])
}

// ============================================================
// Contacts (recruiting leads + clients) — the relationship core
// ============================================================

enum ContactType {
  RECRUIT
  CLIENT
  REFERRAL
}

model Contact {
  id       String      @id @default(cuid())
  agencyId String
  agency   Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ownerId  String?
  owner    User?       @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  type     ContactType @default(CLIENT)
  status   String // pipeline stage; allowed values depend on type (see shared/pipeline)

  firstName String
  lastName  String
  email     String?
  phone     String?

  street String?
  city   String?
  state  String?
  zip    String?

  // Client life details (used to drive relationship automation & cross-sell)
  dateOfBirth       DateTime?
  anniversary       DateTime?
  occupation        String?
  employer          String?
  maritalStatus     String?
  spouseName        String?
  numberOfChildren  Int?
  familyNotes       String?
  retirementGoalAge Int?
  retirementNotes   String?
  incomeBand        String?

  // Recruiting details
  source        String?
  recruitNotes  String?
  resumeUrl     String?

  // Engagement / aged-lead tracking & relationship cadence
  lastContactedAt   DateTime?
  followUpDate      DateTime? // next scheduled follow-up (importable)
  nextTouchpointAt  DateTime? // engine-managed next relationship touchpoint
  isAged            Boolean   @default(false)
  doNotContact      Boolean   @default(false)

  // Recruit -> agent conversion link (no duplicate record)
  convertedUserId String?

  tags  String[] @default([])
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies          Policy[]
  lifeEvents        LifeEvent[]
  referralsGiven    Referral[]   @relation("Referrer")
  referralsReceived Referral[]   @relation("ReferredContact")
  crossSells        CrossSell[]
  tasks             Task[]
  enrollments       Enrollment[]
  messages          Message[]

  @@index([agencyId, type])
  @@index([agencyId, status])
  @@index([ownerId])
}

// ============================================================
// Policies
// ============================================================

model Policy {
  id        String  @id @default(cuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  policyNumber String?
  carrier      String?
  productType  String // TERM_LIFE, WHOLE_LIFE, IUL, FINAL_EXPENSE, ANNUITY, MORTGAGE_PROTECTION, etc.
  faceAmount   Decimal? @db.Decimal(14, 2)
  premium      Decimal? @db.Decimal(12, 2)
  premiumMode  String? // MONTHLY, QUARTERLY, ANNUAL
  status       String   @default("ACTIVE") // ACTIVE, PENDING, LAPSED, CANCELLED, CLAIMED

  effectiveDate DateTime?
  renewalDate   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([contactId])
}

// ============================================================
// Referrals
// ============================================================

model Referral {
  id       String  @id @default(cuid())
  agencyId String
  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  referrerId String?
  referrer   Contact? @relation("Referrer", fields: [referrerId], references: [id], onDelete: SetNull)

  referredContactId String?
  referredContact   Contact? @relation("ReferredContact", fields: [referredContactId], references: [id], onDelete: SetNull)

  referredName  String?
  referredPhone String?
  referredEmail String?

  status       String  @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  rewardStatus String? // PENDING, SENT, NA
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

// ============================================================
// Cross-sell opportunities
// ============================================================

model CrossSell {
  id        String  @id @default(cuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  productType    String
  reason         String?
  status         String   @default("IDENTIFIED") // IDENTIFIED, PRESENTED, IN_PROGRESS, WON, LOST
  estimatedValue Decimal? @db.Decimal(12, 2)
  source         String? // MANUAL or AUTO (engine-detected)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([contactId])
}

// ============================================================
// Life events (birthdays, anniversaries, policy dates, milestones)
// ============================================================

model LifeEvent {
  id        String  @id @default(cuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type      String // BIRTHDAY, ANNIVERSARY, POLICY_ANNIVERSARY, RENEWAL, NEW_BABY, RETIREMENT, MILESTONE, CUSTOM
  title     String
  date      DateTime
  recurring Boolean  @default(false) // true = recurs annually (birthdays/anniversaries)
  notes     String?

  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([contactId])
}

// ============================================================
// Tasks & reminders
// ============================================================

model Task {
  id         String  @id @default(cuid())
  agencyId   String
  agency     Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String    @default("OPEN") // OPEN, DONE
  type        String? // CALL, EMAIL, FOLLOW_UP, MEETING, ONBOARDING, OTHER
  completedAt DateTime?
  autoCreated Boolean   @default(false) // created by the automation engine

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, status])
  @@index([assigneeId])
  @@index([contactId])
}

// ============================================================
// Automation sequences (the "relationship automation" engine)
// ============================================================

model Sequence {
  id          String  @id @default(cuid())
  agencyId    String
  agency      Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name        String
  description String?

  audience      String // RECRUIT, CLIENT, BOTH
  triggerType   String // MANUAL, AGED_LEAD, STATUS_CHANGE, CONTACT_CREATED, BIRTHDAY, ANNIVERSARY, POLICY_SOLD, RENEWAL, REFERRAL_REQUEST
  triggerConfig Json? // e.g. { "status": "NEW" } or { "daysBefore": 14 }
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       SequenceStep[]
  enrollments Enrollment[]

  @@index([agencyId])
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  order     Int
  channel   String // action type: SMS, EMAIL, TASK, NOTE, STATUS, TAG, NOTIFY
  delayDays Int    @default(0) // delay relative to enrollment (or previous step) before this step fires
  delayHours Int   @default(0)

  subject      String? // email subject (templated)
  body         String  @default("") // message/note body or task description (templated with {{variables}})
  taskTitle    String? // for TASK channel
  actionConfig Json? // for STATUS ({status}), TAG ({tags:[]}), NOTIFY ({}) actions

  @@index([sequenceId])
}

model Enrollment {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, STOPPED
  currentStep Int       @default(0) // index of the next step to run
  nextRunAt   DateTime?
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  messages Message[]

  @@unique([sequenceId, contactId])
  @@index([agencyId, status])
  @@index([nextRunAt])
}

// ============================================================
// Messages — the real outbox/log for all automated + manual sends
// ============================================================

model Message {
  id           String  @id @default(cuid())
  agencyId     String
  agency       Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  channel   String // SMS, EMAIL
  direction String @default("OUTBOUND")
  // SCHEDULED (waiting for time) -> QUEUED (due, no provider yet) -> SENDING -> SENT/FAILED, or SKIPPED
  status    String @default("SCHEDULED")

  toAddress   String?
  fromAddress String?
  subject     String?
  body        String

  scheduledAt DateTime?
  sentAt      DateTime?
  providerId  String? // Twilio SID / Resend id
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, status])
  @@index([status, scheduledAt])
  @@index([contactId])
}

// ============================================================
// Activity timeline / audit log
// ============================================================

model Activity {
  id        String  @id @default(cuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactId String?

  type        String // CONTACT_CREATED, STATUS_CHANGED, NOTE_ADDED, POLICY_ADDED, MESSAGE_SENT, ENROLLED, TASK_DONE, REFERRAL_ADDED, etc.
  description String
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([contactId])
}

// ============================================================
// Notifications (reminder/notification center + "notify user" action)
// ============================================================

model Notification {
  id        String  @id @default(cuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String? // target user; null = visible to the whole agency
  contactId String?

  category String // REMINDER, AUTOMATION, ASSIGNMENT, SYSTEM
  type     String // BIRTHDAY, RENEWAL, AGED_LEAD, OVERDUE_TASK, REFERRAL, CROSS_SELL, WORKFLOW, etc.
  title    String
  body     String?
  link     String?
  read     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([agencyId, read])
  @@index([userId])
}
